<?xml version="1.0" encoding="utf-8"?>
<!-- 弹窗按钮默认态: 新拟态凸起(与行内按钮同款) -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:left="2dp"
        android:top="2dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/neu_dark" />
            <corners android:radius="8dp" />
        </shape>
    </item>
    <item
        android:right="2dp"
        android:bottom="2dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/neu_light" />
            <corners android:radius="8dp" />
        </shape>
    </item>
    <item
        android:left="1dp"
        android:right="1dp"
        android:top="1dp"
        android:bottom="1dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/btn_normal_bg" />
            <corners android:radius="8dp" />
        </shape>
    </item>
</layer-list>
