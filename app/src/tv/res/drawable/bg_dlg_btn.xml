<?xml version="1.0" encoding="utf-8"?>
<!-- 弹窗按钮状态背景: 必须是 selector, 否则聚焦无视觉变化(遥控器上表现为"按钮无法获得焦点");
     聚焦/按压 = btn_focused(蓝底, 与行内按钮一致), 默认 = btn_normal_outline(深色填充+细描边, 明确呈按钮) -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true" android:drawable="@drawable/btn_focused" />
    <item android:state_pressed="true" android:drawable="@drawable/btn_focused" />
    <item android:drawable="@drawable/btn_normal_outline" />
</selector>
